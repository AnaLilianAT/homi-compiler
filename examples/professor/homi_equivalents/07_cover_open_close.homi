dispositivo cortina_suite = cover device_id "ed32516b10312da4a71c0ceaad8b66c4" entity_id "8e38e2f9b76939a6c380fad9428f1fd0";

automacao "Suite - cortinas" modo single {
    gatilhos {
        quando hora "22:30:00" id "Abrir blackout";
        quando hora "12:30:00" id "Abrir cortina";
    }

    condicoes {
        se dispositivo alarm_control_panel device_id "5e51e34745f04cf7f80d7a374d922d6f" entity_id "37dc24654a788314bfb4de2e2c827fd0" desarmado;
    }

    acoes {
        se gatilho em ["Abrir blackout"] entao {
            faca abrir cortina_suite;
        }

        se gatilho em ["Abrir cortina"] entao {
            faca fechar cortina_suite;
        }
    }
}
