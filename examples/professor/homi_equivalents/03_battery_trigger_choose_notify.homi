        quando dispositivo sensor device_id "033813d16b9570ea8ed3fe2ee4e908e9" entity_id "d46e6d632a36b57b7c07b1885c32ad88" bateria acima 75 id "+ de 75";
        quando dispositivo sensor device_id "033813d16b9570ea8ed3fe2ee4e908e9" entity_id "d46e6d632a36b57b7c07b1885c32ad88" bateria abaixo 5 id "- de 5";
    }

    acoes {
