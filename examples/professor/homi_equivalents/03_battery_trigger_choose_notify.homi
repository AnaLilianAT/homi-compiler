                faca servico notify.mobile_app_zfold4 dados {
                    message: "Tablet carregando";
                } metadados {
                };
            }

            caso gatilho em ["- de 5"] {
                faca ligar switch device_id "bda1f38607c9e810f10b241569f46c77" entity_id "6a55b660d511de43c42b534c2f201dbb";
                faca servico notify.mobile_app_zfold4 dados {
