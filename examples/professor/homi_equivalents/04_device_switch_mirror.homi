automacao "Lavabo - 3o botao interruptor" modo restart {
    gatilhos {
        quando dispositivo switch device_id "9a51076c10d0adead01a5e23ba16e4dc" entity_id "8aa7f9cf78ad1d62f4df88ca2360df73" ligado id "Liga";
        quando dispositivo switch device_id "9a51076c10d0adead01a5e23ba16e4dc" entity_id "8aa7f9cf78ad1d62f4df88ca2360df73" desligado apelido "Desativado" id "Desliga";
    }

    condicoes {
        se dispositivo alarm_control_panel device_id "5e51e34745f04cf7f80d7a374d922d6f" entity_id "37dc24654a788314bfb4de2e2c827fd0" desarmado;
        se dispositivo switch device_id "17577b83efd0951c4002cd6c7b91053c" entity_id "bb97c45f407329aca067d3f274499a81" desligado habilitado false;
    }

    acoes {
        se gatilho em ["Liga"] entao {
            faca servico switch.turn_on alvo {
                entity_id: [switch.espelho_do_lavabo, switch.sonoff_100200129d_2];
            } dados {
            } metadados {
            };
        }

        se gatilho em ["Desliga"] entao {
            faca servico switch.turn_off alvo {
                entity_id: [switch.sonoff_100200129d_3, switch.sonoff_100200129d_2, switch.sonoff_100200129d_1, switch.espelho_do_lavabo];
            } dados {
            };
            faca servico notify.mobile_app_zfold4 dados {
                message: "Lavabo";
            } metadados {
            };
        }
    }
}
