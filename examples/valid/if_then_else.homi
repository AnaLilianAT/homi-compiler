automacao "Faixa horaria" modo single {
    gatilhos {
        quando dispositivo switch device_id "dev-botao" entity_id "switch.botao_virtual" ligado id "Liga";
    }

    acoes {
        se horario entre "01:15:00" e "12:00:00" entao {
            espere 45s;
        } senao {
            espere 1min45s;
        }
    }
}
