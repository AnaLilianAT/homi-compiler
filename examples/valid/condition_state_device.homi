automacao "Sala - validacao" modo single {
    gatilhos {
        quando hora "19:00:00";
    }

    condicoes {
        se estado switch.luzes_da_sala igual ["off"];
        se dispositivo switch device_id "dev-sala" entity_id "switch.luzes_da_sala" ligado;
    }

    acoes {
        faca servico light.turn_on alvo {
            entity_id: [light.sala];
        } dados {
        };
    }
}
