entidade luz_sala = light.sala;
dispositivo painel_tv = switch device_id "dev-painel" entity_id "switch.painel_tv";

automacao "Servico generico" modo single {
    descricao "Exemplo de delay e acao por servico";

    gatilhos {
        quando hora "22:00:00";
    }

    acoes {
        espere 30s;

        faca servico media_player.volume_set alvo {
            entity_id: [media_player.sala];
            device_id: ["dev-player-a", "dev-player-b"];
        } dados {
            volume_level: 0.5;
            media_content_id: "https://example.com/song.mp3";
            metadata: {
                source: "homi";
            };
        };
    }
}
