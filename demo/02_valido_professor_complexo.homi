automacao "Demo complexo" modo restart {
    descricao "Exemplo para apresentacao final";

    gatilhos {
        quando estado [binary_sensor.movimento_sala] para ["on"] id "Movimento";
        quando hora "18:30:00" id "Hora";
    }

    condicoes {
        se horario entre "18:00:00" e "23:30:00";
    }

    acoes {
        se gatilho em ["Movimento"] entao {
            faca servico notify.mobile_app_zfold4 dados {
                message: "Movimento detectado na sala";
            } metadados {
            };
        } senao {
            espere 30s;
        }

        escolha {
            caso estado weather.forecast_casa igual ["rainy", "pouring"] {
                faca servico automation.trigger alvo {
                    entity_id: [automation.cozinha_ligar_luzes];
                } dados {
                    skip_condition: true;
                };
            }

            caso gatilho em ["Hora"] {
                faca servico light.turn_on alvo {
                    entity_id: [light.sala];
                } dados {
                    brightness_pct: 60;
                };
            }
        }
    }
}
