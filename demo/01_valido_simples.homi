automacao "Demo simples" modo single {
    gatilhos {
        quando estado [binary_sensor.movimento_sala] para ["on"] id "Movimento";
    }

    condicoes {
        se estado light.sala igual ["off"];
    }

    acoes {
        faca ligar light device_id "dev-light-sala" entity_id "light.sala";
        espere 45s;
        faca desligar light device_id "dev-light-sala" entity_id "light.sala";
    }
}
